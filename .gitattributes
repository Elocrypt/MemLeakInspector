# -----------------------------------------------------------------------
# Default: normalize line endings on check-in
# -----------------------------------------------------------------------
* text=auto

# -----------------------------------------------------------------------
# C# source and project files — always LF in repo, CRLF on Windows checkout
# -----------------------------------------------------------------------
*.cs     text eol=crlf diff=csharp
*.csproj text eol=crlf
*.sln    text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf

# -----------------------------------------------------------------------
# Config / data files
# -----------------------------------------------------------------------
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.xml    text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.ps1    text eol=crlf

# -----------------------------------------------------------------------
# Binary files — no line-ending conversion, no diff
# -----------------------------------------------------------------------
*.dll    binary
*.exe    binary
*.pdb    binary
*.zip    binary
*.gz     binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
