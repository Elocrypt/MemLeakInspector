# -----------------------------------------------------------------------
# MemLeakInspector — runtime-generated data (not for source control)
# -----------------------------------------------------------------------
# Snapshot files, exports, and thread logs written by the mod at runtime.
# These live inside the VS data directory, not the repo — but guard against
# someone accidentally running the server from inside the repo folder.
*.json.gz
build/stage/
build/dist/
